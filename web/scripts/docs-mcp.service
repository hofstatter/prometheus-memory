[Unit]
Description=Prometheus Docs MCP Server (:8767) — docs-as-service (SSE)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=~/atlas-scripts
EnvironmentFile=/opt/prometheus/.env
Environment=DOCS_MCP_PORT=8767
Environment=DOCS_DIR=/data/docs
ExecStart=~/atlas-venv/bin/python3 ~/atlas-scripts/docs_mcp_server.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
