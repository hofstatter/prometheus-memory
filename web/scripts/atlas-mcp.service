[Unit]
Description=Atlas MCP Server (:8768) — memória para agentes (SSE)
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=%h/atlas-scripts
EnvironmentFile=/opt/prometheus/.env
Environment=ATLAS_MCP_PORT=8768
Environment=ATLAS_DIARIO_DB=/data/atlas/atlas_diario.db
ExecStart=%h/atlas-venv/bin/python3 %h/atlas-scripts/atlas_memory_agent.py
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
