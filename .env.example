# Prometheus Memory — Configuração
# Copie para .env e preencha com seus valores reais.

# Obrigatório para o pipeline L2/L3 (cenas, persona, skills)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Web UI
PROMETHEUS_HOST=127.0.0.1
PROMETHEUS_PORT=8777
# OBRIGATORIO quando PROMETHEUS_HOST != 127.0.0.1 (ex.: 0.0.0.0):
# senha do login da UI (sessao de 30 dias no navegador)
# PROMETHEUS_PASSWORD=
# token Bearer p/ agentes/scripts via API. Gere: openssl rand -hex 24
# PROMETHEUS_TOKEN=
# true = UI inteira protegida (toda rota /api exige login)
# PROMETHEUS_PROTECT_READS=false
# Opcional (v0.2): backend PostgreSQL para tabelas do Prometheus
# DATABASE_URL=postgresql://user:pass@localhost:5432/prometheus

# Diretórios (deixe em branco para usar os padrões)
# MNEMOSYNE_HOME=~/.hermes/mnemosyne
# PROMETHEUS_DB=~/.hermes/mnemosyne/data/mnemosyne.db
# PROMETHEUS_NOTES_DIR=~/notes

# Identidade usada nas memórias geradas pelo pipeline
PROMETHEUS_USER=seu-nome
PROMETHEUS_PROJECT=meu-projeto

# Filtros (separados por vírgula; use aspas se houver espaços)
# PROMETHEUS_PROJECTS=ProjA,ProjB
# PROMETHEUS_EXCLUDE="termo1,termo dois"

# Opcional: fallback de scraping para sites com JS/Cloudflare (Notes)
# FIRECRAWL_API_KEY=fc-your-firecrawl-key-here
